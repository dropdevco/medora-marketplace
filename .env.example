# =============================================================================
# MedSociety Marketplace — Environment Variables Template
# =============================================================================
# Copy this file to .env.local (never commit .env.local) and fill in the values.
#
#   cp .env.example .env.local
#
# -----------------------------------------------------------------------------
# FRONTEND KEYS  (bundled into client-side JS by Vite — use VITE_ prefix)
# These are safe to expose in the browser *only* when:
#   • Google Maps API key has HTTP referrer restrictions set in Google Cloud Console
#   • Supabase anon key is paired with Row Level Security (RLS) policies on every table
# -----------------------------------------------------------------------------

# Google Maps JavaScript API (also needs Places API + Geocoding enabled in Cloud Console)
# → https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# Supabase project URL and anon (public) key
# → https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SERVER-ONLY KEYS  (never use VITE_ prefix — must stay out of the browser bundle)
# Only used by scripts run locally or in CI (e.g. seed-providers.ts)
# -----------------------------------------------------------------------------

# Supabase service-role key (bypasses RLS — NEVER expose to the browser)
# → https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_SERVICE_ROLE_KEY=

# Cloud Translation API key — a different product from the Maps key above,
# needs its own "Cloud Translation API" enabled in the same (or any) Google
# Cloud project. Used only by scripts/doctoralia/translate-services.ts, to
# translate scraped Spanish service names into English once and cache the
# result on the row — not used anywhere at request time.
# → https://console.cloud.google.com/apis/library/translate.googleapis.com
GOOGLE_TRANSLATE_API_KEY=

# -----------------------------------------------------------------------------
# LEAD NOTIFICATIONS  (server-only — used by api/lead-notify.ts on Vercel)
# Set these in Vercel → Settings → Environment Variables, not just locally.
# -----------------------------------------------------------------------------

# Resend API key for sending the "new listing request" email
# → https://resend.com/api-keys
RESEND_API_KEY=

# Shared secret between the Supabase Database Webhook and api/lead-notify.ts.
# Generate with: openssl rand -hex 32
# Must match the `x-webhook-secret` header configured on the webhook.
LEAD_NOTIFY_SECRET=

# Where new-lead alerts are sent (comma-separated for several recipients)
LEAD_NOTIFY_TO=hello@medsociety.one

# Sender — the domain must be verified in Resend or sends will 403
LEAD_NOTIFY_FROM=MedSociety <leads@medsociety.one>
